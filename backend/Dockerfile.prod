FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

# Build context is the repository root so the demo dataset ships inside the image.
COPY backend/pyproject.toml ./
COPY backend/app ./app
# Add "[live]" to bake in LiteLLM for live model calls; the public demo runs mock models only.
ARG EXTRAS=""
RUN pip install ".${EXTRAS}"

COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY datasets ./datasets
ENV DEMO_DATASET_PATH=/app/datasets/demo_dataset.json

RUN useradd --create-home --uid 10001 app
USER app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8000'),timeout=4)"

# Hosts such as Render provide $PORT. Migrations run first so a fresh database is ready.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --no-access-log"]
