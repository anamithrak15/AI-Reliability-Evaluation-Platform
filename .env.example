# Copy to .env. Placeholders only; never commit real keys.
POSTGRES_USER=aireliability
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aireliability

# Overridden inside docker compose to point at the service hostnames.
DATABASE_URL=postgresql+psycopg://aireliability:change-me@localhost:5432/aireliability
REDIS_URL=redis://localhost:6379/0

DEMO_MODE=true
ENABLE_LIVE_LLM=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Used only when ENABLE_LIVE_LLM=true (Day 4+)
OPENAI_API_KEY=
