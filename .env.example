# Copy to .env. Placeholders only; never commit real keys.
POSTGRES_USER=aireliability
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aireliability

# Overridden inside docker compose to point at the service hostnames.
DATABASE_URL=postgresql+psycopg://aireliability:change-me@localhost:5432/aireliability
REDIS_URL=redis://localhost:6379/0

DEMO_MODE=true
ENABLE_LIVE_LLM=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Accounts. Leave SECRET_KEY empty in development (a built-in dev key is used). In production it must be
# a random value of 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# ENVIRONMENT=production   # refuses to start with the dev key or insecure cookies
# COOKIE_SECURE=true       # required when ENVIRONMENT=production
# ALLOW_REGISTRATION=true
# TRUSTED_PROXY_HOPS=0     # number of reverse proxies in front of the API

# Email (verification and password reset). Without SMTP_HOST nothing is sent; outside production the
# message, including its link, is written to the API log instead.
# PUBLIC_BASE_URL=http://localhost:3000   # frontend origin used in email links
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="AI Reliability <no-reply@example.com>"
# REQUIRE_EMAIL_VERIFICATION=false   # true blocks data access until verified; needs SMTP in production

# Used only when ENABLE_LIVE_LLM=true. LIVE_MODELS maps an alias to a LiteLLM model string.
# LIVE_MODELS={"gpt-mini":"openai/gpt-4o-mini"}
# Free local option (Ollama): LIVE_MODELS={"llama-local":"ollama/llama3.2:3b"}
# OLLAMA_API_BASE=http://host.docker.internal:11434
# LIVE_TIMEOUT_SECONDS=120
# Per-run spend cap in USD for each model (0 disables). Overrides are keyed by alias.
# LIVE_BUDGET_USD_PER_MODEL=0.05
# LIVE_BUDGET_OVERRIDES={"gpt-mini":0.02}
OPENAI_API_KEY=
